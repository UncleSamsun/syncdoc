# PostgreSQL 컨테이너 (deploy/compose.yaml)
SYNCDOC_DB_NAME=syncdoc
SYNCDOC_DB_USER=syncdoc
SYNCDOC_DB_PASSWORD=syncdoc
SYNCDOC_DB_HOST_PORT=5433

# 백엔드 (backend/src/main/resources/application.yaml)
SYNCDOC_DB_URL=jdbc:postgresql://localhost:5433/syncdoc
SYNCDOC_PORT=8080

# GitHub App — TASK-002에서 사용. 값이 없으면 GitHub 연동은 미설정 상태로 명시적으로 실패한다.
SYNCDOC_GITHUB_APP_ID=
SYNCDOC_GITHUB_CLIENT_ID=
SYNCDOC_GITHUB_CLIENT_SECRET=
SYNCDOC_GITHUB_PRIVATE_KEY=

# 로그인 경계 (backend). 값이 없으면 로그인은 동작하지 않는다.
# SYNCDOC_ADMIN_GITHUB_USER_ID에 넣은 GitHub 사용자 ID가 최초 관리자다.
SYNCDOC_ADMIN_GITHUB_USER_ID=
SYNCDOC_CSRF_KEY=
SYNCDOC_TOKEN_KEY=
SYNCDOC_COOKIE_SECURE=false
